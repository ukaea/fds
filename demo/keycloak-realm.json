{
    "realm": "fds",
    "enabled": true,
    "roles": {
        "client": {
            "fds-client": [
                {
                    "name": "fds-admin",
                    "description": "Administrator role for fds"
                },
                {
                    "name": "mast_admin",
                    "description": "Administrator role for MAST device"
                }
            ]
        }
    },
    "groups": [],
    "users": [
        {
            "username": "admin",
            "enabled": true,
            "email": "admin@example.com",
            "firstName": "Admin",
            "lastName": "User",
            "credentials": [
                {
                    "type": "password",
                    "value": "password",
                    "temporary": false
                }
            ],
            "clientRoles": {
                "fds-client": [
                    "fds-admin"
                ]
            }
        },
        {
            "username": "user",
            "enabled": true,
            "email": "user@example.com",
            "firstName": "Regular",
            "lastName": "User",
            "credentials": [
                {
                    "type": "password",
                    "value": "password",
                    "temporary": false
                }
            ]
        },
        {
            "username": "mast_admin",
            "enabled": true,
            "email": "mast_admin@example.com",
            "firstName": "MAST",
            "lastName": "Admin",
            "credentials": [
                {
                    "type": "password",
                    "value": "password",
                    "temporary": false
                }
            ],
            "clientRoles": {
                "fds-client": [
                    "mast_admin"
                ]
            }
        }
    ],
    "clients": [
        {
            "clientId": "fds-client",
            "enabled": true,
            "publicClient": false,
            "secret": "fds-client-secret",
            "clientAuthenticatorType": "client-secret",
            "directAccessGrantsEnabled": true,
            "redirectUris": [
                "http://localhost:8000/*",
                "http://localhost:3000/*"
            ],
            "webOrigins": [
                "*"
            ],
            "protocol": "openid-connect",
            "fullScopeAllowed": true,
            "defaultClientScopes": [
                "profile",
                "email"
            ],
            "optionalClientScopes": [
                "fds-admin"
            ],
            "protocolMappers": [
                {
                    "name": "fds-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.client.audience": "fds-client",
                        "id.token.claim": "false",
                        "access.token.claim": "true"
                    }
                },
                {
                    "name": "client-roles-to-scope",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-client-role-mapper",
                    "consentRequired": false,
                    "config": {
                        "uset.client.role.mappings": "true",
                        "claim.name": "scope",
                        "jsonType.label": "String",
                        "multivalued": "true",
                        "access.token.claim": "true",
                        "id.token.claim": "true"
                    }
                }
            ]
        }
    ],
    "clientScopes": [
        {
            "name": "fds-admin",
            "protocol": "openid-connect",
            "attributes": {
                "include.in.token.scope": "true"
            }
        },
        {
            "name": "profile",
            "protocol": "openid-connect"
        },
        {
            "name": "email",
            "protocol": "openid-connect"
        }
    ],
    "defaultDefaultClientScopes": [
        "profile",
        "email"
    ]
}