{
    "realm": "fds",
    "enabled": true,
    "roles": {
        "client": {
            "fds": [
                {
                    "name": "fds-admin",
                    "description": "Administrator role for fds"
                },
                {
                    "name": "mast-write",
                    "description": "Example role: the example catalogue lists it in MAST's write_roles"
                },
                {
                    "name": "mast-read",
                    "description": "Example role for records that list it in read_roles"
                }
            ]
        }
    },
    "groups": [],
    "users": [
        {
            "username": "admin",
            "enabled": true,
            "email": "admin@example.com",
            "firstName": "Admin",
            "lastName": "User",
            "credentials": [
                {
                    "type": "password",
                    "value": "password",
                    "temporary": false
                }
            ],
            "clientRoles": {
                "fds": [
                    "fds-admin"
                ]
            }
        },
        {
            "username": "user",
            "enabled": true,
            "email": "user@example.com",
            "firstName": "Regular",
            "lastName": "User",
            "credentials": [
                {
                    "type": "password",
                    "value": "password",
                    "temporary": false
                }
            ]
        },
        {
            "username": "mast-writer",
            "enabled": true,
            "email": "mast-writer@example.com",
            "firstName": "MAST",
            "lastName": "Writer",
            "credentials": [
                {
                    "type": "password",
                    "value": "password",
                    "temporary": false
                }
            ],
            "clientRoles": {
                "fds": [
                    "mast-write"
                ]
            }
        }
    ],
    "clients": [
        {
            "clientId": "fds",
            "name": "FDS API",
            "description": "Holds FDS's roles, and is the audience every token for FDS carries. Nobody logs in through it.",
            "enabled": true,
            "publicClient": false,
            "clientAuthenticatorType": "client-secret",
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "protocol": "openid-connect"
        },
        {
            "clientId": "fds-ui",
            "enabled": true,
            "publicClient": false,
            "secret": "fds-ui-secret",
            "clientAuthenticatorType": "client-secret",
            "directAccessGrantsEnabled": true,
            "redirectUris": [
                "http://localhost:8000/*",
                "http://localhost:3000/*",
                "http://localhost:3001/*"
            ],
            "webOrigins": [
                "*"
            ],
            "protocol": "openid-connect",
            "fullScopeAllowed": true,
            "defaultClientScopes": [
                "profile",
                "email"
            ],
            "optionalClientScopes": [],
            "protocolMappers": [
                {
                    "name": "fds-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.client.audience": "fds",
                        "id.token.claim": "false",
                        "access.token.claim": "true"
                    }
                },
                {
                    "name": "fds-roles",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-client-role-mapper",
                    "consentRequired": false,
                    "config": {
                        "usermodel.clientRoleMapping.clientId": "fds",
                        "claim.name": "roles",
                        "jsonType.label": "String",
                        "multivalued": "true",
                        "access.token.claim": "true",
                        "id.token.claim": "true"
                    }
                }
            ]
        }
    ],
    "clientScopes": [
        {
            "name": "profile",
            "protocol": "openid-connect"
        },
        {
            "name": "email",
            "protocol": "openid-connect"
        }
    ],
    "defaultDefaultClientScopes": [
        "profile",
        "email"
    ]
}
