# Copy to .env and edit. Every setting has a working default, so an empty .env
# starts a functioning service with SQLite, anonymous access only, and no
# storage providers configured.
#
# The demo stack sets these itself in demo/docker-compose.yaml; this file is for
# running FDS directly.

# --- Application ---------------------------------------------------------

FDS_APP_NAME=fds
FDS_DEBUG=false
# "dev" or "prod". Selects the default log format when FDS_LOG_FORMAT is unset.
FDS_ENVIRONMENT=dev
FDS_LOG_LEVEL=INFO
# "json", "console", or empty to follow FDS_ENVIRONMENT.
FDS_LOG_FORMAT=

# --- Database ------------------------------------------------------------

# FDS runs on PostgreSQL. The schema is created and kept current by
# `alembic upgrade head`, which the container image runs before starting.
FDS_DB_HOST=localhost
FDS_DB_PORT=5432
FDS_DB_NAME=fds
FDS_DB_USER=fds
FDS_DB_PASSWORD=
# A complete URL, which overrides the four settings above when set.
FDS_DB_URL=

# --- Identity ------------------------------------------------------------

# Expected "aud" claim. Tokens for a different audience are rejected.
FDS_OIDC_AUDIENCE=fds-client

# JSON array of trusted issuers. FDS fetches each issuer's JWKS to validate
# signatures. "allowed_scopes" of ["*"] accepts any scope from that issuer.
# An empty list means no token is ever accepted, leaving anonymous access to
# PUBLIC metadata as the only route in.
#
# Per issuer, the keys are discovered from the issuer URL by default. Two
# optional overrides:
#   "jwks_uri"  fetch the keys from this URL instead of discovering them, for
#               when FDS reaches the provider at a different address from the
#               one in the token (a container network, say).
#   "jwks_file" read the keys from this file; no provider is contacted. Lets
#               you sign tokens yourself for bootstrapping, automation and
#               emergencies. See scripts/mint-token.py and the Access Control
#               documentation, including what it costs you.
# The two are mutually exclusive.
FDS_TRUSTED_IDPS=[{"issuer":"http://localhost:8080/realms/fds","allowed_scopes":["*"]}]

# --- Storage -------------------------------------------------------------

# Lifetime in seconds of the credentials FDS vends to clients.
FDS_CREDENTIAL_TOKEN_DURATION=3600

# JSON array of storage providers. "endpoint_url" is what clients are told to
# connect to; "sts_endpoint_url" is what FDS itself calls to mint credentials.
# They differ whenever FDS and the client see the store at different addresses,
# as they do inside a container network.
#
# S3:
FDS_STORAGE_PROVIDERS=[{"type":"s3","endpoint_url":"http://localhost:9000","region":"us-east-1","sts_endpoint_url":"http://minio:9000","sts_role_arn":"arn:aws:iam::123456789012:role/fds-role"}]
#
# GCS:    [{"type":"gcs","endpoint_url":null}]
# Azure:  [{"type":"azure","endpoint_url":null}]
#
# GCS and Azure read their own credentials from the ambient environment
# (Application Default Credentials, and DefaultAzureCredential respectively).
